# LLM Backend (OpenAI-compatible / LiteLLM)
LLM_HOST=https://llm.ersensari.com
LLM_MODEL=gpt-4o
LLM_API_KEY=your-litellm-api-key

# OCR engine: "paddle" (heavy, memory issues) or "tesseract" (light, reliable)
OCR_ENGINE=tesseract

# Rendering resolution for OCR page images
RENDER_DPI=300

# Frontend -> backend base URL
VITE_API_BASE_URL=http://localhost:8001
